rules_version = '2';

// Reisekasse: Reisen gehören ihren Mitgliedern.
// Rollen: owner (alles, Mitglieder verwalten, löschen), editor (Inhalt bearbeiten), viewer (nur lesen).
// Beitreten nur mit dem Einladungsschlüssel, den der Besitzer in der Reise hinterlegt hat.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function isMember(d) { return signedIn() && uid() in d.memberIds; }
    function roleIn(d) { return d.members[uid()]; }
    function canEdit(d) { return isMember(d) && roleIn(d) in ['owner', 'editor']; }
    function isOwner(d) { return isMember(d) && d.owner == uid(); }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    // Gast ohne Konto (anonyme Anmeldung, #435): darf beitreten und mitplanen, aber nichts Eigenes anlegen
    function guest() { return request.auth.token.firebase.sign_in_provider == 'anonymous'; }
    // „Wer bist du?“ (#435): je Konto höchstens eine Zuordnung { t: Reisende-Kennung, n: Vorname }
    function claimsOf(d) { return d.get('claims', {}); }
    function ownClaimOnly() {
      return claimsOf(request.resource.data).diff(claimsOf(resource.data)).affectedKeys().hasOnly([uid()])
        && (!(uid() in claimsOf(request.resource.data))
          || (claimsOf(request.resource.data)[uid()].keys().hasOnly(['t', 'n'])
            && claimsOf(request.resource.data)[uid()].t is string && claimsOf(request.resource.data)[uid()].t.size() > 0 && claimsOf(request.resource.data)[uid()].t.size() < 64
            && claimsOf(request.resource.data)[uid()].n is string && claimsOf(request.resource.data)[uid()].n.size() <= 40));
    }

    // memberIds und members beschreiben dieselben Personen, genau ein Besitzer
    function consistent(d) {
      return d.memberIds is list && d.members is map
        && d.members.keys().hasAll(d.memberIds) && d.memberIds.hasAll(d.members.keys())
        && d.memberIds.size() == d.members.size()
        && d.members[d.owner] == 'owner';
    }
    function validInvite(d) {
      return !('invite' in d) || d.invite == null
        || (d.invite.key is string && d.invite.key.size() >= 16 && d.invite.role in ['editor', 'viewer']);
    }
    function validContent(d) {
      return d.data is string && d.data.size() < 900000 && d.name is string && d.name.size() < 200;
    }

    // Gespeicherte Personen und Gruppen: nur für die eigene Person
    match /profiles/{userId} {
      allow read, delete: if signedIn() && uid() == userId;
      allow create, update: if signedIn() && uid() == userId
        && request.resource.data.keys().hasOnly(['data', 'updatedAt'])
        && request.resource.data.data is string && request.resource.data.data.size() < 500000;
    }

    // Buchungsdaten (Ausweis, Reisepass): nur für einen selbst, nie für Mitreisende oder Eingeladene
    match /travelDocs/{userId} {
      allow read, delete: if signedIn() && uid() == userId;
      allow create, update: if signedIn() && uid() == userId
        && request.resource.data.keys().hasOnly(['data', 'updatedAt'])
        && request.resource.data.data is string && request.resource.data.data.size() < 200000;
    }

    // Aktionsseite zum Mitfinanzieren: jeder mit dem Link darf sie lesen (nur Titel, Beträge, PayPal-Name, Link zur Sammelaktion;
    // keine Mitreisenden). Anlegen, ändern und löschen nur das Konto, das veröffentlicht hat.
    function validCampaign(d) {
      return d.keys().hasOnly(['owner', 'trip', 'title', 'text', 'place', 'from', 'to', 'goal', 'raised', 'pledged', 'paypal', 'link', 'updatedAt'])
        && d.owner == uid()
        && d.trip is string && d.trip.size() < 64
        && d.title is string && d.title.size() > 0 && d.title.size() <= 100
        && d.text is string && d.text.size() <= 600
        && d.place is string && d.place.size() <= 100
        && d.from is string && d.from.size() <= 10 && d.to is string && d.to.size() <= 10
        && d.goal is number && d.goal >= 0 && d.goal < 10000000
        && d.raised is number && d.raised >= 0 && d.pledged is number && d.pledged >= 0
        && d.paypal is string && d.paypal.matches('^[A-Za-z0-9._-]{0,40}$')
        // Sammelaktion nur bei bekannten Anbietern (wie LINK_HOSTS in campaign.ts); Kontoinhaber und IBAN vorerst nicht
        && d.link is string && d.link.size() <= 200
        && (d.link == '' || d.link.matches('^https://(gofundme\\.com|gofund\\.me|leetchi\\.com|betterplace\\.me|ko-fi\\.com|revolut\\.me)/[^ ]+$'));
    }
    match /campaigns/{campaignId} {
      // einzeln per Link lesbar; die Sammlung abfragen nur für die eigenen (Konto zurücksetzen), sonst ließen sich alle
      // PayPal-Namen auf einmal auslesen
      allow get: if true;
      allow list: if signedIn() && resource.data.owner == uid();
      allow create: if signedIn() && !guest() && validCampaign(request.resource.data);
      allow update: if signedIn() && resource.data.owner == uid() && validCampaign(request.resource.data);
      allow delete: if signedIn() && resource.data.owner == uid();
    }

    // Angebotsspeicher (#462): nur der Such-Dienst (Dienstkonto, umgeht die Regeln); die App liest und schreibt nie
    match /offers/{offerId} {
      allow read, write: if false;
    }
    match /offerInputs/{inputId} {
      allow read, write: if false;
    }

    match /trips/{tripId} {
      // Nicht vorhandene Reisen dürfen angemeldete Nutzer "lesen" (verrät nur, dass die zufällige ID frei ist);
      // nötig, damit das Anlegen prüfen kann, ob es die Reise schon gibt, statt sie zu überschreiben.
      allow read: if (signedIn() && resource == null) || isMember(resource.data);

      allow create: if signedIn() && !guest()
        && request.resource.data.owner == uid()
        && request.resource.data.memberIds == [uid()]
        && request.resource.data.members.keys().hasOnly([uid()])
        && consistent(request.resource.data)
        && validInvite(request.resource.data)
        && validContent(request.resource.data);

      allow update: if
        // Inhalt bearbeiten: Mitglieder, Besitzer und Einladung bleiben unverändert
        (canEdit(resource.data)
          && !changed().hasAny(['owner', 'memberIds', 'members', 'memberNames', 'invite', 'joinKey', 'claims'])
          && validContent(request.resource.data))
        // Besitzer verwaltet Mitglieder und Einladung
        || (isOwner(resource.data)
          && request.resource.data.owner == resource.data.owner
          && consistent(request.resource.data)
          && validInvite(request.resource.data)
          && validContent(request.resource.data))
        // Beitreten mit Einladungsschlüssel: nur sich selbst hinzufügen, mit der Rolle der Einladung
        || (signedIn()
          && !(uid() in resource.data.memberIds)
          && resource.data.get('invite', null) != null
          && request.resource.data.joinKey == resource.data.invite.key
          && changed().hasOnly(['memberIds', 'members', 'memberNames', 'joinKey'])
          && request.resource.data.memberIds == resource.data.memberIds.concat([uid()])
          && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([uid()])
          && request.resource.data.members[uid()] == resource.data.invite.role
          && request.resource.data.memberNames.diff(resource.data.get('memberNames', {})).affectedKeys().hasOnly([uid()]))
        // eigene Zuordnung setzen, ändern oder lösen (jede Rolle, auch „nur ansehen“ und Gäste)
        || (isMember(resource.data)
          && changed().hasOnly(['claims'])
          && ownClaimOnly())
        // Reise verlassen (nicht der Besitzer): nur sich selbst entfernen (samt eigener Zuordnung)
        || (isMember(resource.data)
          && resource.data.owner != uid()
          && changed().hasOnly(['memberIds', 'members', 'memberNames', 'claims'])
          && claimsOf(request.resource.data).diff(claimsOf(resource.data)).affectedKeys().hasOnly([uid()])
          && request.resource.data.memberIds.toSet() == resource.data.memberIds.toSet().difference([uid()].toSet())
          && request.resource.data.members.keys().toSet() == resource.data.members.keys().toSet().difference([uid()].toSet())
          && request.resource.data.members.diff(resource.data.members).changedKeys().size() == 0
          && request.resource.data.get('memberNames', {}).diff(resource.data.get('memberNames', {})).affectedKeys().hasOnly([uid()]));

      allow delete: if isOwner(resource.data);

      // Stimmen (#432): je Mitglied ein eigenes Dokument, damit sich gleichzeitige Stimmen nicht überschreiben.
      // Lesen alle Mitglieder; schreiben nur die eigene Stimme (auch „nur ansehen“ und Gäste); Besitzer darf löschen.
      match /votes/{userId} {
        function tripDoc() { return get(/databases/$(database)/documents/trips/$(tripId)).data; }
        allow read: if isMember(tripDoc());
        allow create, update: if isMember(tripDoc()) && uid() == userId
          && request.resource.data.keys().hasOnly(['v', 'w', 'at'])
          && request.resource.data.v is map && request.resource.data.v.size() <= 40
          // zu „Ohne mich“ (#439): Grund und „mit Familie“ je Abstimmung
          && (!('w' in request.resource.data) || (request.resource.data.w is map && request.resource.data.w.size() <= 40));
        allow delete: if signedIn() && (uid() == userId || isOwner(tripDoc()));
      }

      // Selbst eintragen (#571): je Mitglied ein Dokument mit eigenen Terminen (a), Wohnort der Familie (h),
      // Familienvorschlag (f) und Familie stimmt mit (x, l, d; #585); jede Rolle, auch „nur ansehen“ und Gäste, nur das eigene; lesen alle Mitglieder.
      match /self/{userId} {
        function tripDoc() { return get(/databases/$(database)/documents/trips/$(tripId)).data; }
        function validSelf(d) {
          return d.keys().hasOnly(['a', 'h', 'f', 'x', 'l', 'd', 'at'])
            && (!('a' in d) || (d.a is map && d.a.size() <= 400))
            && (!('h' in d) || (d.h is map && d.h.keys().hasOnly(['plz', 'cc', 'lat', 'lon', 'ort', 'region'])))
            && (!('f' in d) || (d.f is map && d.f.keys().hasOnly(['m', 'at']) && d.f.m is list && d.f.m.size() <= 12 && d.f.at is string))
            // Familie stimmt mit (#585): abgewählt, stimmt wie, entschieden
            && (!('x' in d) || (d.x is list && d.x.size() <= 12))
            && (!('l' in d) || (d.l is string && d.l.size() <= 40))
            && (!('d' in d) || d.d is bool);
        }
        allow read: if isMember(tripDoc());
        allow create, update: if isMember(tripDoc()) && uid() == userId && validSelf(request.resource.data);
        allow delete: if signedIn() && (uid() == userId || isOwner(tripDoc()));
      }

      // Gruppenchat: je Nachricht ein Dokument. Lesen und schreiben alle Mitglieder (auch „nur ansehen“ und Gäste),
      // nur im eigenen Namen, nicht ändern; löschen Verfasser (auch nach dem Verlassen der Reise) und Besitzer.
      match /chat/{msgId} {
        function tripDoc() { return get(/databases/$(database)/documents/trips/$(tripId)).data; }
        allow read: if isMember(tripDoc());
        allow create: if isMember(tripDoc())
          && request.resource.data.keys().hasOnly(['u', 'n', 't', 'img', 'at'])
          && request.resource.data.u == uid()
          && request.resource.data.n is string && request.resource.data.n.size() <= 40
          && request.resource.data.t is string && request.resource.data.t.size() <= 1000
          && request.resource.data.at == request.time
          && (!('img' in request.resource.data) || request.resource.data.img == true)
          && (request.resource.data.t.size() > 0 || request.resource.data.get('img', false) == true);
        allow delete: if signedIn() && (resource.data.u == uid() || isOwner(tripDoc()));
      }
      // Bild einer Nachricht (gleiche Kennung), verkleinert als JPEG/WebP/PNG in einer data:-Adresse
      match /chatImg/{msgId} {
        function tripDoc() { return get(/databases/$(database)/documents/trips/$(tripId)).data; }
        allow read: if isMember(tripDoc());
        allow create: if isMember(tripDoc())
          && request.resource.data.keys().hasOnly(['u', 'd'])
          && request.resource.data.u == uid()
          && request.resource.data.d is string && request.resource.data.d.size() < 340000
          && request.resource.data.d.matches('data:image/(jpeg|webp|png);base64,[A-Za-z0-9+/=]+');
        allow delete: if signedIn() && (resource.data.u == uid() || isOwner(tripDoc()));
      }
    }
  }
}
