# Testumgebung (elvau.github.io/startrek/, Build mit `npm run build:test`): eigenes Firebase-Projekt, nie das echte.
# Solange die Werte leer sind, läuft die Testumgebung ohne Anmeldung (nur lokal auf dem Gerät).
# Einrichtung: docs/FIREBASE.md, Abschnitt „Testprojekt“. Werte sind nicht geheim (stehen ohnehin in der Seite).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Such-Dienst wie in Produktion; er nimmt Anmeldungen aus dem Testprojekt an (FIREBASE_TEST_PROJECT_ID im Worker)
VITE_FLIGHTS_URL=https://startrek.danielbednorz1990.workers.dev
